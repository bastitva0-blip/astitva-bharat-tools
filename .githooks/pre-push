#!/bin/sh
# ============================================================
#  BharatTools Frontend — Pre-push Hook
#  Blocks direct pushes to `main`. Use a PR instead.
# ============================================================

PROTECTED_BRANCH="main"

while read local_ref local_sha remote_ref remote_sha; do
  remote_branch=$(echo "$remote_ref" | sed 's|refs/heads/||')

  if [ "$remote_branch" = "$PROTECTED_BRANCH" ]; then
    echo ""
    echo "  ╔══════════════════════════════════════════════════════╗"
    echo "  ║  🚫  Direct push to '$PROTECTED_BRANCH' is not allowed.       ║"
    echo "  ║                                                      ║"
    echo "  ║  Please push to a feature branch and open a PR:     ║"
    echo "  ║    git push origin HEAD:<your-branch-name>           ║"
    echo "  ║                                                      ║"
    echo "  ║  To bypass (use only in emergencies):                ║"
    echo "  ║    git push --no-verify                              ║"
    echo "  ╚══════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
done

exit 0
